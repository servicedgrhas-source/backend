# ─── Serveur ───────────────────────────────────────────────────────────
PORT=4000
# production en ligne (Render) ; vide sur le poste
NODE_ENV=
# Adresse(s) de l'interface autorisées (virgules). Ex. en ligne :
# FRONTEND_ORIGIN=https://dgrhas.vercel.app,https://*.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
# Nombre de proxys devant le serveur (Render : 1)
TRUST_PROXY=1

# ─── Base de données ───────────────────────────────────────────────────
# En ligne (Supabase, pooler en mode session, port 5432) — prioritaire sur DB_* :
# DATABASE_URL=postgresql://postgres.<projet>:<MOT_DE_PASSE>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# SSL : automatique (activé avec DATABASE_URL sauf localhost)
# DB_SSL=true
# Connexions simultanées (Supabase gratuit : rester bas)
DB_POOL_MAX=5
# Sur le poste (si DATABASE_URL est vide)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=inrap
# true : TypeORM aligne les tables tout seul (poste uniquement).
# false/absent en ligne : les migrations (src/migrations) sont jouées au démarrage.
DB_SYNC=true

# ─── Amorçage ─────────────────────────────────────────────────────────
# Charge amorcage/configuration.json au premier démarrage d'une base vide. non = désactivé
AMORCAGE=

# ─── Sécurité / comptes ───────────────────────────────────────────────
# Chaîne aléatoire d'au moins 32 caractères. NE JAMAIS LA CHANGER une fois en service :
# elle chiffre aussi les codes personnels (les changer les rendrait illisibles).
JWT_SECRET=
# Premier administrateur, créé seulement si aucun compte n'existe
ADMIN_EMAIL=admin@dgrhas.cg
ADMIN_PASSWORD=

# ─── Stockage des scans ───────────────────────────────────────────────
# r2 = Cloudflare R2 (obligatoire en ligne : le disque de Render est effacé à chaque déploiement)
# local = disque (UPLOAD_DIR)
STOCKAGE=r2
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dgrhas
# Sous-dossier dans le bucket (ex. production) ; vide = racine
R2_PREFIXE=
